    "back=SimpleCNN(num_classes=4, input_size=IMG_SIZE).features\n",
    "# Calculate the correct feature dimension size\n",
    "with torch.no_grad():\n",
    "\tdummy = torch.zeros(1, 1, IMG_SIZE, IMG_SIZE)\n",
    "\tout = back(dummy)\n",
    "\tfd = out.shape[1] * out.shape[2] * out.shape[3]  # Calculate actual flattened dimensions\n",
    "\n",
    "dh=DoubleHeadCNN(nn.Sequential(back, nn.Flatten()), fd)\n",
    "run('DH-CNN', dh)\n",
    "pd.DataFrame([{k:v for k,v in d.items() if k!='net'} for d in res])"
