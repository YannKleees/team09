    "IMG_SIZE = 224\n",
    "def clahe_pil(img):\n",
    "    arr = np.array(img, dtype=np.uint8)\n",
    "    clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8,8))\n",
    "    return Image.fromarray(clahe.apply(arr))\n",
    "def build_preprocess():\n",
    "    return T.Compose([T.Lambda(clahe_pil),\n",
    "                      T.Resize((IMG_SIZE, IMG_SIZE)),\n",
    "                      T.ToTensor(),\n",
    "                      T.Lambda(lambda x: (x - x.mean())/(x.std()+1e-7))])\n",
    "BASE = build_preprocess()\n",
    "TRAIN_TF = T.Compose([T.RandomHorizontalFlip(), *BASE.transforms])\n",
    "VAL_TF = BASE"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "2433d9b5",
   "metadata": {},
   "outputs": [],
   "source": [
    "BATCH = 16\n",
    "NICK_ROOT = PROJECT_ROOT / 'data' / 'archive'\n",
    "def loaders():\n",
    "    tr = BrainTumorDataset(NICK_ROOT,'Training',transform=TRAIN_TF)\n",
    "    va = BrainTumorDataset(NICK_ROOT,'Testing', transform=VAL_TF)\n",
    "    return (DataLoader(tr,BATCH,shuffle=True,num_workers=4,pin_memory=True),\n",
    "            DataLoader(va,BATCH,shuffle=False,num_workers=4,pin_memory=True))\n",
    "train_ld, val_ld = loaders()"
   ]
