    "# Cell: RN18‑TL\n",
    "train_ld = DataLoader(train_ld.dataset, BATCH, shuffle=True,\n",
    "                      num_workers=0, pin_memory=True)\n",
    "val_ld   = DataLoader(val_ld.dataset,   BATCH, shuffle=False,\n",
    "                      num_workers=0, pin_memory=True)\n",
    "rn18 = models.resnet18(weights='IMAGENET1K_V1')\n",
    "old_weight = rn18.conv1.weight.data\n",
    "rn18.conv1 = nn.Conv2d(in_channels=1,\n",
    "                       out_channels=64,\n",
    "                       kernel_size=7,\n",
    "                       stride=2,\n",
    "                       padding=3,\n",
    "                       bias=False)\n",
    "with torch.no_grad():\n",
    "    rn18.conv1.weight[:] = old_weight.mean(dim=1, keepdim=True)\n",
    "\n",
    "rn18.fc = nn.Linear(rn18.fc.in_features, 4)\n",
    "\n",
    "run('RN18-TL', rn18)\n"
   ]
