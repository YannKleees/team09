    "def train_ep(m,ld,crit,opt):\n",
    "    m.train()\n",
    "    for x,y in ld:\n",
    "        x,y = x.to(DEVICE), y.to(DEVICE)\n",
    "        opt.zero_grad(); crit(m(x),y).backward(); opt.step()\n",
    "@torch.no_grad()\n",
    "def evaluate(m,ld,crit):\n",
    "    m.eval(); corr=tot=0; yt=[]; yp=[]\n",
    "    for x,y in ld:\n",
    "        x,y = x.to(DEVICE), y.to(DEVICE)\n",
    "        o=m(x); corr+=(o.argmax(1)==y).sum().item(); tot+=y.size(0)\n",
    "        yt+=y.cpu().tolist(); yp+=o.argmax(1).cpu().tolist()\n",
    "    return corr/tot, f1_score(yt,yp,average='macro')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "5b4c11a0",
   "metadata": {},
   "outputs": [],
   "source": [
    "EPOCHS=10; LR=1e-3; WD=1e-4; crit=nn.CrossEntropyLoss()\n",
    "res=[]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "27871e65",
   "metadata": {},
   "outputs": [],
   "source": [
    "from collections import defaultdict\n",
    "history = defaultdict(list)\n",
    "\n",
    "def train_one_epoch(model, name, crit, ld, opt):\n",
    "    model.train()\n",
    "    running_loss, corr, tot = 0.0, 0, 0\n",
    "    for x, y in ld:\n",
    "        x, y = x.to(DEVICE), y.to(DEVICE)\n",
    "        opt.zero_grad()\n",
    "        out = model(x)\n",
    "        loss = crit(out, y)\n",
    "        loss.backward()\n",
    "        opt.step()\n",
    "        running_loss += loss.item() * x.size(0)\n",
    "        corr += (out.argmax(1) == y).sum().item()\n",
    "        tot += x.size(0)\n",
    "    history[(name, 'train_loss')].append(running_loss / tot)\n",
    "    history[(name, 'train_acc')].append(corr / tot)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "f11651a4",
   "metadata": {},
   "outputs": [],
   "source": [
    "def run(name, model):\n",
    "    model.to(DEVICE)\n",
    "    optimiser = optim.Adam(model.parameters(), lr=LR, weight_decay=WD)\n",
    "    best = 0.0\n",
    "    for ep in range(EPOCHS):\n",
    "        train_one_epoch(model, name, crit, train_ld, optimiser)\n",
    "        val_acc, val_f1 = evaluate(model, val_ld, crit)\n",
    "        history[(name, 'val_acc')].append(val_acc)\n",
    "        history[(name, 'val_f1')].append(val_f1)\n",
    "        best = max(best, val_acc)\n",
    "    res.append({'model': name, 'nick_acc': best, 'net': model})\n"
   ]
  },
