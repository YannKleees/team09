    "class DoubleHeadCNN(nn.Module):\n",
    "    def __init__(self, backbone, feat):\n",
    "        super().__init__()\n",
    "        self.backbone = backbone\n",
    "        self.head_bin = nn.Linear(feat,2)\n",
    "        self.head_tri = nn.Linear(feat,3)\n",
    "    def forward(self,x):\n",
    "        f = self.backbone(x)\n",
    "        b = self.head_bin(f)\n",
    "        t = self.head_tri(f)\n",
    "        tp = torch.softmax(t,1)\n",
    "        return torch.cat([b[:,:1], b[:,1:2]*tp],1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "856ab76b",
   "metadata": {},
