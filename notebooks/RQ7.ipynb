      "source": [
        "import os\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.optim as optim\n",
        "import torch.nn.functional as F\n",
        "from torch.utils.data import Dataset, DataLoader\n",
        "from torchvision import transforms\n",
        "from PIL import Image\n",
        "from tqdm import tqdm\n",
        "from sklearn.metrics import accuracy_score, precision_recall_fscore_support, confusion_matrix\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import random\n",
        "import warnings\n",
        "import json\n",
        "import re\n",
        "from collections import defaultdict\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "# --- Dataset Classes ---\n",
        "class BrainTumorDatasetCustom(Dataset):\n",
        "    \"\"\"Original dataset loader for brain tumor images\"\"\"\n",
        "    def __init__(self, root_dir, subset=\"Training\", transform=None):\n",
        "        super().__init__()\n",
        "        self.classes = ['glioma', 'meningioma', 'notumor', 'pituitary']\n",
        "        self.class_to_idx = {cls:i for i,cls in enumerate(self.classes)}\n",
        "        self.samples = []\n",
        "        data_path = os.path.join(root_dir, subset)\n",
        "        if not os.path.isdir(data_path):\n",
        "            raise FileNotFoundError(f\"{data_path} not found\")\n",
        "        for cls in self.classes:\n",
        "            cls_dir = os.path.join(data_path, cls)\n",
        "            if not os.path.isdir(cls_dir): continue\n",
        "            for f in os.listdir(cls_dir):\n",
        "                if f.lower().endswith('.jpg'):\n",
        "                    self.samples.append((os.path.join(cls_dir,f), self.class_to_idx[cls]))\n",
        "        print(f\"Loaded {len(self.samples)} samples from {subset}\")\n",
        "        self.transform = transform\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.samples)\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "        path, lbl = self.samples[idx]\n",
        "        img = Image.open(path).convert('RGB')\n",
        "        if self.transform:\n",
        "            img = self.transform(img)\n",
        "        return img, lbl\n",
        "\n",
        "class BraTSTestDataset(Dataset):\n",
        "    \"\"\"Dataset for testing on BraTS middle slice data\"\"\"\n",
        "    def __init__(self, root_dir, transform=None):\n",
        "        super().__init__()\n",
        "        self.transform = transform\n",
        "        self.samples = []\n",
        "\n",
        "        # Define the three axes folders\n",
        "        axes = ['Axial', 'Coronal', 'Sagittal']\n",
        "\n",
        "        for axis in axes:\n",
        "            axis_path = os.path.join(root_dir, axis)\n",
        "            if not os.path.isdir(axis_path):\n",
        "                print(f\"Warning: {axis_path} not found\")\n",
        "                continue\n",
        "\n",
        "            # Process all image files in the axis folder\n",
        "            for fname in os.listdir(axis_path):\n",
        "                if fname.lower().endswith(('.jpg', '.jpeg', '.png')):\n",
        "                    # Parse scanner type from filename\n",
        "                    scanner_type = self._extract_scanner_type(fname)\n",
        "\n",
        "                    full_path = os.path.join(axis_path, fname)\n",
        "                    self.samples.append({\n",
        "                        'path': full_path,\n",
        "                        'filename': fname,\n",
        "                        'axis': axis.lower(),\n",
        "                        'scanner_type': scanner_type\n",
        "                    })\n",
        "\n",
        "        print(f\"Loaded {len(self.samples)} BraTS test samples\")\n",
        "        print(f\"Axes found: {set([s['axis'] for s in self.samples])}\")\n",
        "        print(f\"Scanner types found: {set([s['scanner_type'] for s in self.samples])}\")\n",
        "\n",
        "    def _extract_scanner_type(self, filename):\n",
        "        \"\"\"Extract scanner type from filename\"\"\"\n",
        "        # Pattern examples:\n",
        "        # BraTS-GLI-00000-000_flair_...\n",
        "        # BraTS-GLI-00000-000_t1_...\n",
        "        # BraTS-GLI-00000-000_t1ce_...\n",
        "        # BraTS-GLI-00000-000_t2_...\n",
        "\n",
        "        # Remove extension and convert to lowercase\n",
        "        name = os.path.splitext(filename)[0].lower()\n",
        "\n",
        "        # Common scanner types in BraTS\n",
        "        scanner_patterns = ['flair', 't1ce', 't1c', 't2', 't1']\n",
        "\n",
        "        for pattern in scanner_patterns:\n",
        "            if f'_{pattern}_' in name or name.endswith(f'_{pattern}'):\n",
        "                return pattern\n",
        "\n",
        "        # If no pattern found, try to extract from standard position\n",
        "        parts = name.split('_')\n",
        "        if len(parts) >= 2:\n",
        "            potential_scanner = parts[1]\n",
        "            if potential_scanner in scanner_patterns:\n",
        "                return potential_scanner\n",
        "\n",
        "        return 'unknown'\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.samples)\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "        sample = self.samples[idx]\n",
        "        img = Image.open(sample['path']).convert('RGB')\n",
        "        if self.transform:\n",
        "            img = self.transform(img)\n",
        "        return img, sample\n",
        "\n",
        "# --- LP Convolution Model Architecture ---\n",
        "class LpConv2d(nn.Module):\n",
        "    def __init__(self, in_channels, out_channels, kernel_size, stride=1, padding=0,\n",
        "                 p_init=2.0, sigma_init=None):\n",
        "        super().__init__()\n",
        "        self.weight = nn.Parameter(torch.randn(out_channels, in_channels, kernel_size, kernel_size))\n",
        "        self.p = nn.Parameter(torch.full((out_channels,), float(p_init)))\n",
        "        if sigma_init is None:\n",
        "            sigma_init = kernel_size/2\n",
        "        L_diag = torch.full((out_channels, 2), 1/sigma_init)\n",
        "        self.L_diag = nn.Parameter(L_diag)\n",
        "        self.L_off = nn.Parameter(torch.zeros(out_channels, 1))\n",
        "        self.register_buffer('offsets', self._make_grid(kernel_size))\n",
        "        self.stride, self.padding = stride, padding\n",
        "\n",
        "    def _make_grid(self, k):\n",
        "        h = torch.linspace(0, k-1, k) - (k-1)/2\n",
        "        w = torch.linspace(0, k-1, k) - (k-1)/2\n",
        "        yy, xx = torch.meshgrid(h, w, indexing='ij')\n",
        "        grid = torch.stack([yy, xx], 0)\n",
        "        grid = (grid - grid.min())/(grid.max() - grid.min())\n",
        "        return grid.unsqueeze(0)\n",
        "\n",
        "    def _cov(self):\n",
        "        L = torch.zeros(self.L_diag.size(0), 2, 2, device=self.L_diag.device)\n",
        "        L[:, 0, 0] = self.L_diag[:, 0]\n",
        "        L[:, 1, 1] = self.L_diag[:, 1]\n",
        "        L[:, 1, 0] = self.L_off[:, 0]\n",
        "        C = torch.bmm(L, L.transpose(1, 2))\n",
        "        return C\n",
        "\n",
        "    def forward(self, x):\n",
        "        p = torch.clamp(self.p, 1.0)\n",
        "        C = self._cov()\n",
        "        off = self.offsets.expand(C.size(0), -1, -1, -1)\n",
        "        C_delta = torch.einsum('oij,ojhw->oihw', C, off)\n",
        "\n",
        "        lp_norm = torch.zeros(C.size(0), self.weight.size(2), self.weight.size(3),\n",
        "                            device=C_delta.device)\n",
        "        for o in range(C_delta.size(0)):\n",
        "            abs_val = torch.abs(C_delta[o])\n",
        "            powered = torch.pow(abs_val, p[o])\n",
        "            summed = torch.sum(powered, dim=0)\n",
        "            lp_norm[o] = torch.pow(summed, p[o])\n",
        "\n",
        "        mask = torch.exp(-lp_norm)\n",
        "        mask = mask.unsqueeze(1)\n",
        "\n",
        "        return F.conv2d(x, self.weight * mask, padding=self.padding, stride=self.stride)\n",
        "\n",
        "class LpCNN(nn.Module):\n",
        "    def __init__(self, num_classes=4, kernel_sizes=[7,7], channels=[64,128], p_init=2.0, input_size=224):\n",
        "        super().__init__()\n",
        "        layers = []\n",
        "        in_c = 3\n",
        "\n",
        "        for k, ch in zip(kernel_sizes, channels):\n",
        "            layers += [\n",
        "                LpConv2d(in_c, ch, k, padding=k//2, p_init=p_init),\n",
        "                nn.BatchNorm2d(ch),\n",
        "                nn.ReLU(True),\n",
        "                nn.MaxPool2d(2)\n",
        "            ]\n",
        "            in_c = ch\n",
        "\n",
        "        self.features = nn.Sequential(*layers)\n",
        "\n",
        "        # Calculate feature size\n",
        "        with torch.no_grad():\n",
        "            dummy = torch.zeros(1, 3, input_size, input_size)\n",
        "            n_features = self.features(dummy).view(1, -1).size(1)\n",
        "\n",
        "        self.classifier = nn.Linear(n_features, num_classes)\n",
        "\n",
        "    def forward(self, x):\n",
        "        x = self.features(x)\n",
        "        x = x.view(x.size(0), -1)\n",
        "        return self.classifier(x)\n",
        "\n",
        "# --- Training Functions ---\n",
        "def init_weights(m):\n",
        "    if isinstance(m, (nn.Conv2d, LpConv2d)):\n",
        "        nn.init.kaiming_normal_(m.weight)\n",
        "    elif isinstance(m, nn.Linear):\n",
        "        nn.init.xavier_normal_(m.weight)\n",
        "        nn.init.zeros_(m.bias)\n",
        "\n",
        "def train_model(model, device, train_loader, test_loader, epochs=15, model_name=\"\"):\n",
        "    \"\"\"Train the model on the original dataset\"\"\"\n",
        "    model.apply(init_weights)\n",
        "    model.to(device)\n",
        "    optimizer = optim.Adam(model.parameters(), lr=1e-3, weight_decay=1e-4)\n",
        "    scheduler = optim.lr_scheduler.ReduceLROnPlateau(optimizer, 'min', patience=3)\n",
        "    criterion = nn.CrossEntropyLoss()\n",
        "\n",
        "    best_acc = 0\n",
        "    best_weights = None\n",
        "\n",
        "    print(f\"\\nTraining {model_name}...\")\n",
        "    for epoch in range(epochs):\n",
        "        # Training\n",
        "        model.train()\n",
        "        train_loss = 0\n",
        "        for batch_idx, (data, target) in enumerate(train_loader):\n",
        "            data, target = data.to(device), target.to(device)\n",
        "            optimizer.zero_grad()\n",
        "            output = model(data)\n",
        "            loss = criterion(output, target)\n",
        "            loss.backward()\n",
        "            optimizer.step()\n",
        "            train_loss += loss.item()\n",
        "\n",
        "        # Validation\n",
        "        model.eval()\n",
        "        correct = 0\n",
        "        total = 0\n",
        "        with torch.no_grad():\n",
        "            for data, target in test_loader:\n",
        "                data, target = data.to(device), target.to(device)\n",
        "                output = model(data)\n",
        "                pred = output.argmax(dim=1)\n",
        "                correct += pred.eq(target).sum().item()\n",
        "                total += target.size(0)\n",
        "\n",
        "        acc = correct / total\n",
        "        scheduler.step(1 - acc)\n",
        "\n",
        "        print(f'Epoch {epoch+1}/{epochs}: Train Loss: {train_loss/len(train_loader):.4f}, '\n",
        "              f'Val Acc: {acc:.4f}')\n",
        "\n",
        "        if acc > best_acc:\n",
        "            best_acc = acc\n",
        "            best_weights = model.state_dict().copy()\n",
        "\n",
        "    # Load best weights\n",
        "    model.load_state_dict(best_weights)\n",
        "    print(f\"{model_name} - Best validation accuracy: {best_acc:.4f}\")\n",
        "    return model, best_acc\n",
        "\n",
        "# --- BraTS Testing Functions ---\n",
        "def test_on_brats(model, device, brats_dataset, class_names):\n",
        "    \"\"\"Test the model on BraTS dataset and collect detailed results\"\"\"\n",
        "    model.eval()\n",
        "\n",
        "    # Initialize results storage\n",
        "    results = {\n",
        "        'all_predictions': [],\n",
        "        'all_probabilities': [],\n",
        "        'all_metadata': [],\n",
        "        'by_scanner': defaultdict(lambda: {'predictions': [], 'probabilities': [], 'metadata': []}),\n",
        "        'by_axis': defaultdict(lambda: {'predictions': [], 'probabilities': [], 'metadata': []}),\n",
        "        'by_scanner_axis': defaultdict(lambda: defaultdict(lambda: {'predictions': [], 'probabilities': [], 'metadata': []}))\n",
        "    }\n",
        "\n",
        "    # Process each sample\n",
        "    with torch.no_grad():\n",
        "        for i in tqdm(range(len(brats_dataset)), desc=\"Testing on BraTS\"):\n",
        "            img, metadata = brats_dataset[i]\n",
        "\n",
        "            # Add batch dimension and move to device\n",
