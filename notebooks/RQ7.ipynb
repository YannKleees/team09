    "### Biologically‑inspired – LpCNN  \n",
    "Same macro layout as SCNN‑4 but every second convolution is replaced  \n",
    "by an \\(L_{p}\\) layer with learnable receptive‑field masks\n",
    "Suited to capture irregular tumour boundaries at low resolution.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c94f7f93",
   "metadata": {},
   "outputs": [],
   "source": [
    "def convert_first_conv_to_grayscale(model):\n",
    "    \"\"\"\n",
    "    Find the first Conv2d with in_channels == 3, replace it with\n",
    "    an identical layer that has in_channels == 1, and copy weights\n",
    "    by averaging the RGB kernels.\n",
    "    \"\"\"\n",
    "    for name, module in model.named_modules():\n",
    "        if isinstance(module, nn.Conv2d) and module.in_channels == 3:\n",
    "            # Build the new layer\n",
    "            new_conv = nn.Conv2d(\n",
    "                in_channels=1,\n",
    "                out_channels=module.out_channels,\n",
    "                kernel_size=module.kernel_size,\n",
    "                stride=module.stride,\n",
    "                padding=module.padding,\n",
    "                dilation=module.dilation,\n",
    "                groups=module.groups,\n",
    "                bias=(module.bias is not None),\n",
    "                padding_mode=module.padding_mode,\n",
    "            )\n",
    "            # Copy weights (average over channel dim)\n",
    "            with torch.no_grad():\n",
    "                new_conv.weight.copy_(module.weight.mean(dim=1, keepdim=True))\n",
    "                if module.bias is not None:\n",
    "                    new_conv.bias.copy_(module.bias)\n",
    "            # Replace the layer inside its parent\n",
    "            parent = model\n",
    "            path = name.split(\".\")\n",
    "            for p in path[:-1]:\n",
    "                parent = getattr(parent, p)\n",
    "            setattr(parent, path[-1], new_conv)\n",
    "            break\n",
    "    return model\n",
    "\n",
    "\n",
    "lp = LpCNN(num_classes=4, in_channels=1)\n",
    "lp.apply(init_lp_weights)\n",
    "run(\"LpCNN\", lp)\n"
   ]
  },
